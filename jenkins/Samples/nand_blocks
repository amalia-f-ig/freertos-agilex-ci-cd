pipeline {
  agent any

  parameters {
    booleanParam(name: 'I2C', defaultValue: true, description: 'Run I2C stage')
    booleanParam(name: 'I3C', defaultValue: true, description: 'Run I3C stage')
    booleanParam(name: 'SDMMC_eMMC', defaultValue: true, description: 'Run SDMMC eMMC stage')
  }

  stages {
    stage('I2C') {
      when { expression { params.I2C } }
      steps {
        catchError(
          buildResult:   'SUCCESS',
          stageResult:   'FAILURE',
          catchInterruptions: false
        ) {
          script {
            def result = build(
              job: 'CI-CD Pipelines/Samples/I2C Test',
              wait: true,
              propagate: false
            )
            echo "🔷 I2C #${result.number} → ${result.result}"
            if (result.result != 'SUCCESS') {
              error("Test failed")
            }
          }
        }
      }
    }

    stage('I3C') {
      when { expression { params.I3C } }
      steps {
        catchError(
          buildResult:   'SUCCESS',
          stageResult:   'FAILURE',
          catchInterruptions: false
        ) {
          script {
            def result = build(
              job: 'CI-CD Pipelines/Samples/I3C Test',
              wait: true,
              propagate: false
            )
            echo "🔷 I3C #${result.number} → ${result.result}"
            if (result.result != 'SUCCESS') {
              error("Test failed")
            }
          }
        }
      }
    }

    stage('SDMMC eMMC') {
      when { expression { params.SDMMC } }
      steps {
        catchError(
          buildResult:   'SUCCESS',
          stageResult:   'FAILURE',
          catchInterruptions: false
        ) {
          script {
            def result = build(
              job: 'CI-CD Pipelines/Samples/SDMMC eMMC Test',
              wait: true,
              propagate: false
            )
            echo "🔷 SDMMC eMMC Test #${result.number} → ${result.result}"
            if (result.result != 'SUCCESS') {
              error("Test failed")
            }
          }
        }
      }
    }
  }

  post {
    always {
      echo "🏁 I2C, I3C & SDMMC eMMC pipeline complete"
    }
  }
}
