pipeline {
  agent any

  parameters {
    booleanParam(name: 'I2C', defaultValue: true, description: 'Run I2C stage')
    booleanParam(name: 'I3C', defaultValue: true, description: 'Run I3C stage')
  }

  stages {
    stage('I2C') {
      when { expression { params.I2C } }
      steps {
        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
          script {
            def result = build(
              job: 'CI-CD Pipelines/CLI Tests/I2C Test',
              wait: true,
              propagate: false
            )
            echo "🔷 I2C #${result.number} → ${result.result}"
          }
        }
      }
    }

    stage('I3C') {
      when { expression { params.I3C } }
      steps {
        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
          script {
            def result = build(
              job: 'CI-CD Pipelines/CLI Tests/I3C Driver Test',
              wait: true,
              propagate: false
            )
            echo "🔷 I3C #${result.number} → ${result.result}"
          }
        }
      }
    }
  }

  post {
    always {
      echo "🏁 I2C & I3C pipeline complete"
    }
  }
}
