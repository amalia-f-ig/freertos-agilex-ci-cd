pipeline {
  agent any

  stages {

    stage('I3C') {
      steps {
        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
          script {
            def result = build(
              job: 'CI-CD Pipelines/Samples (new ATF)/I3C Test',
              wait: true,
              propagate: false
            )
            echo "🔷 I3C #${result.number} → ${result.result}"

            dir('artifacts') {
              sh 'mkdir -p I3C'
              copyArtifacts(
                projectName: 'CI-CD Pipelines/Samples (new ATF)/I3C Test',
                selector: specific("${r.number}"),
                filter: 'test_results.txt',
                optional: true
              )
              sh """
                if [ -f test_results.txt ]; then
                  mv test_results.txt I3C/i3c_test_results.txt
                fi
              """
            }
          }
        }
      }
    }


    stage('I2C') {
      steps {
        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
          script {
            def result = build(
              job: 'CI-CD Pipelines/Samples (new ATF)/I2C Test',
              wait: true,
              propagate: false
            )
            echo "🔷 I2C #${result.number} → ${result.result}"

            dir('artifacts') {
              sh 'mkdir -p I2C'
              copyArtifacts(
                projectName: 'CI-CD Pipelines/Samples (new ATF)/I2C Test',
                selector: specific("${r.number}"),
                filter: 'test_results.txt',
                optional: true
              )
              sh """
                if [ -f test_results.txt ]; then
                  mv test_results.txt I2C/i2c_test_results.txt
                fi
              """
            }
          }
        }
      }
    }


  }

  post {
    always {
      echo "🏁 All stages complete"
      archiveArtifacts artifacts: 'artifacts/**/*', allowEmptyArchive: true
    }
  }
}
