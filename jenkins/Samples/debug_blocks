pipeline {
  agent any

  parameters {
    booleanParam(name: 'RSU', defaultValue: true, description: 'Run RSU stage')
    booleanParam(name: 'SPI', defaultValue: true, description: 'Run SPI stage')
  }

  stages {
    stage('RSU') {
      when { expression { params.RSU } }
      steps {
        catchError(
          buildResult:   'SUCCESS',
          stageResult:   'FAILURE',
          catchInterruptions: false
        ) {
          script {
            def result = build(
              job: 'CI-CD Pipelines/Tests/RSU test',
              wait: true,
              propagate: false
            )
            echo "🔷 RSU #${result.number} → ${result.result}"
            if (result.result != 'SUCCESS') {
              error("Test failed")
            }
          }
        }
      }
    }

    stage('SPI') {
      when { expression { params.SPI } }
      steps {
        catchError(
          buildResult:   'SUCCESS',
          stageResult:   'FAILURE',
          catchInterruptions: false
        ) {
          script {
            def result = build(
              job: 'CI-CD Pipelines/Tests/SPI Test',
              wait: true,
              propagate: false
            )
            echo "🔷 SPI #${result.number} → ${result.result}"
            if (result.result != 'SUCCESS') {
              error("Test failed")
            }
          }
        }
      }
    }
  }

  post {
    always {
      echo "🏁 RSU & SPI pipeline complete"
    }
  }
}
