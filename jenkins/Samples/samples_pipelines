        script {
          def result = null
          // Trigger build
          try {
            result = build(
              job: 'CI-CD Pipelines/Samples (new ATF)/Bridge test',
              wait: true,
              propagate: false
            )
            echo "🔷 Bridge #${result.number} → ${result.result}"
          } catch (e) {
            echo "❌ Bridge build step error: ${e}"
          }
          // Copy artifacts
          try {
            dir("artifacts/Bridge") {
              copyArtifacts(
                projectName: 'CI-CD Pipelines/Samples (new ATF)/Bridge test',
                selector: specific(result?.number ?: ''),
                filter: '**/*',
                optional: true
              )
            }
