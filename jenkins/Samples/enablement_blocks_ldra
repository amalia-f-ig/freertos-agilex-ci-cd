        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
          script {
            def result = build(
              job: 'CI-CD Pipelines/Samples (new ATF)/Bridge test',
              wait: true,
              propagate: false
            )
            echo "🔷 Bridge #${result.number} → ${result.result}"

            dir('artifacts') {
              sh 'mkdir -p Bridge'
              copyArtifacts(
                projectName: 'CI-CD Pipelines/Samples (new ATF)/Bridge test',
                selector: specific("${r.number}"),
                filter: 'test_results.txt',
                optional: true
              )
              sh """
                if [ -f test_results.txt ]; then
                  mv test_results.txt BRIDGE/bridge_test_results.txt
