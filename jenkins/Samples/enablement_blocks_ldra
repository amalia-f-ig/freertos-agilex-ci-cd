pipeline {
  agent any

  parameters {
    booleanParam(name: 'Bridge',        defaultValue: true,  description: 'Run Bridge stage')
    booleanParam(name: 'DMA',           defaultValue: true,  description: 'Run DMA stage')
    booleanParam(name: 'FATFS',         defaultValue: true,  description: 'Run FATFS stage')
    booleanParam(name: 'FPGA_Manager',  defaultValue: true,  description: 'Run FPGA Manager stage')
    booleanParam(name: 'GPIO',          defaultValue: true,  description: 'Run GPIO stage')
    booleanParam(name: 'IOSSM',         defaultValue: true,  description: 'Run IOSSM stage')
    booleanParam(name: 'QSPI',          defaultValue: true,  description: 'Run QSPI stage')
    booleanParam(name: 'REBOOT',        defaultValue: true,  description: 'Run Reboot stage')
