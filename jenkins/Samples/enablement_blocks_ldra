      when { expression { params.Bridge } }
      steps {
        catchError(
          buildResult:   'SUCCESS',
          stageResult:   'FAILURE',
          catchInterruptions: false
        ) {
          script {
            def result = build(
              job: 'CI-CD Pipelines/Tests/Bridge test',
              wait: true,
              propagate: false
            )
            echo "🔷 Bridge #${result.number} → ${result.result}"
            if (result.result != 'SUCCESS') {
              error("Test failed")
            }
          }
        }
      }
    }

