pipeline {
  agent any

  parameters {
    booleanParam(name: 'SEU', defaultValue: true, description: 'Run SEU stage')
    booleanParam(name: 'FCS', defaultValue: true, description: 'Run FCS stage')
  }

  stages {
    stage('SEU') {
      when { expression { params.SEU } }
      steps {
        catchError(
          buildResult:   'SUCCESS',
          stageResult:   'FAILURE',
          catchInterruptions: false
        ) {
          script {
            def result = build(
              job: 'CI-CD Pipelines/CLI Tests/SEU Test',
              wait: true,
              propagate: false
            )
            echo "🔷 SEU #${result.number} → ${result.result}"
            if (result.result != 'SUCCESS') {
              error("Test failed")
            }
          }
        }
      }
    }

    stage('FCS') {
      when { expression { params.FCS } }
      steps {
        catchError(
          buildResult:   'SUCCESS',
          stageResult:   'FAILURE',
          catchInterruptions: false
        ) {
          script {
            def result = build(
              job: 'CI-CD Pipelines/CLI Tests/FCS Driver Test',
              wait: true,
              propagate: false
            )
            echo "🔷 FCS #${result.number} → ${result.result}"
            if (result.result != 'SUCCESS') {
              error("Test failed")
            }
          }
        }
      }
    }
  }

  post {
    always {
      echo "🏁 SEU & FCS pipeline complete"
    }
  }
}
