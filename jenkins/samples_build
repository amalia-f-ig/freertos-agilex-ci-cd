pipeline {
    agent any

    environment {
        SAMPLES_DIR = '/var/lib/jenkins/workspace/CI-CD Pipelines/Samples'
    }

    stages {
        stage('Verify Samples Path') {
            steps {
                sh '''
                    echo "📁 Checking absolute path: $SAMPLES_DIR"
                    if [ ! -d "$SAMPLES_DIR" ]; then
                        echo "❌ ERROR: Directory not found: $SAMPLES_DIR"
                        exit 1
                    fi
                    echo "✅ Found Samples dir: $SAMPLES_DIR"
                '''
            }
        }

        stage('List Sample Folders') {
            steps {
                script {
                    def SAMPLE_DIRS = sh(
                        script: "find '/var/lib/jenkins/workspace/CI-CD Pipelines/Samples' -mindepth 1 -maxdepth 1 -type d -printf '%f\\n'",
                        returnStdout: true
                    ).trim().split('\n')
                    echo "📦 Found samples: ${SAMPLE_DIRS}"
                    env.SAMPLE_LIST = SAMPLE_DIRS.join(',')
                }
            }
        }

        stage('Build Each Sample (Retry x3)') {
            steps {
                script {
                    def dirs = env.SAMPLE_LIST.tokenize(',')
                    for (dirName in dirs) {
                        echo "▶️ Building: ${dirName}"
                        def success = false
                        for (int attempt = 1; attempt <= 3; attempt++) {
                            try {
                                echo "  🔁 Attempt ${attempt}..."
                                dir("/var/lib/jenkins/workspace/CI-CD Pipelines/Samples/${dirName}") {
                                    if (fileExists('Jenkinsfile')) {
                                        load 'Jenkinsfile'
                                    } else {
                                        echo "  ⚠️ No Jenkinsfile found in ${dirName}, skipping"
                                    }
                                }
                                echo "✅ Success: ${dirName}"
                                success = true
                                break
                            } catch (e) {
                                echo "❌ Failed: ${dirName} (Attempt ${attempt})"
                                if (attempt == 3) {
                                    error("🔥 ${dirName} failed after 3 retries.")
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo "🏁 Pipeline finished"
        }
    }
}
