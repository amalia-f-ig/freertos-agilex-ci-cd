pipeline {
    agent any

    environment {
        // Absolute path to your Samples directory
        SAMPLES_DIR = '/var/lib/jenkins/workspace/CI-CD Pipelines/Samples'
    }

    stages {
        stage('Verify Samples Path') {
            steps {
                sh '''
                    echo "📁 Checking absolute path: $SAMPLES_DIR"
                    if [ ! -d "$SAMPLES_DIR" ]; then
                        echo "❌ ERROR: Directory not found: $SAMPLES_DIR"
                        exit 1
                    fi
                    echo "✅ Found Samples dir: $SAMPLES_DIR"
                '''
            }
        }

        stage('List Sample Folders') {
            steps {
                script {
                    // Find all immediate subdirectories under SAMPLES_DIR
                    def SAMPLE_DIRS = sh(
                        script: "find \"$SAMPLES_DIR\" -mindepth 1 -maxdepth 1 -type d -printf '%f\\n'",
                        returnStdout: true
                    ).trim().split('\\n')

                    // Filter out any temporary folders (e.g. those ending with @tmp)
                    SAMPLE_DIRS = SAMPLE_DIRS.findAll { !it.endsWith('@tmp') }
                    
                    echo "📦 Will trigger pipelines for: ${SAMPLE_DIRS}"
                    env.SAMPLE_LIST = SAMPLE_DIRS.join(',')
                }
            }
        }

        stage('Trigger Sample Pipelines (Retry x3)') {
            steps {
                script {
                    // Tokenize the comma‑separated list into an array
                    def dirs = env.SAMPLE_LIST.tokenize(',')
                    for (dirName in dirs) {
                        echo "🚀 Triggering pipeline job: '${dirName}'"
                        boolean success = false

                        for (int attempt = 1; attempt <= 3; attempt++) {
                            try {
                                echo "  🔁 Attempt ${attempt} for job '${dirName}'"
                                // Trigger the downstream Jenkins job with the same name
                                build job: dirName, wait: true
                                echo "✅ Job '${dirName}' succeeded"
                                success = true
                                break
                            } catch (err) {
                                echo "❌ Job '${dirName}' failed on attempt ${attempt}: ${err}"
                                if (attempt == 3) {
                                    error("🔥 Job '${dirName}' failed after 3 attempts — aborting pipeline.")
                                } else {
                                    echo "🔄 Retrying job '${dirName}'..."
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo "🏁 All done. Check above logs for details."
        }
    }
}
