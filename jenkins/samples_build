pipeline {
    agent any

    environment {
        // ← point this at the on‑disk samples folder you discovered
        SAMPLES_DIR = 'jenkins/Samples'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Debug: Walk the FS') {
            steps {
                // (You can remove this entire stage once everything’s green)
                sh '''
                  echo "Workspace root: $PWD"
                  echo "Top‑level dirs:"
                  ls -1
                  echo ""
                  echo "jenkins/:"
                  ls -1 jenkins
                '''
            }
        }

        stage('List Samples') {
            steps {
                script {
                    SAMPLE_DIRS = sh(
                        script:  'find "jenkins/Samples" -mindepth 1 -maxdepth 1 -type d -printf "%f\\n"',
                        returnStdout: true
                    ).trim().split('\n')

                    echo "✅ Found sample folders: ${SAMPLE_DIRS.join(', ')}"
                }
            }
        }

        stage('Build Each Sample with Retry') {
            steps {
                script {
                    for (dirName in SAMPLE_DIRS) {
                        echo "⏳ Starting build for sample: ${dirName}"
                        def success = false
                        def attempt = 0

                        while (!success && attempt < 3) {
                            attempt++
                            echo "➡️  Attempt #${attempt} for ${dirName}"
                            try {
                                // cd into the sample’s folder
                                dir("${SAMPLES_DIR}/${dirName}") {
                                    if (fileExists('Jenkinsfile')) {
                                        echo "   ▶️  Loading Jenkinsfile in ${dirName}"
                                        load 'Jenkinsfile'
                                    } else {
                                        echo "   ⚠️  No Jenkinsfile found in ${dirName}, skipping"
                                    }
                                }
                                success = true
                                echo "✅ Build succeeded for ${dirName} on attempt ${attempt}"
                            } catch (err) {
                                echo "❌ Build failed for ${dirName} on attempt ${attempt}: ${err}"
                                if (attempt == 3) {
                                    error("🚨 ${dirName} failed after 3 attempts — aborting pipeline")
                                } else {
                                    echo "🔄 Retrying ${dirName}..."
                                }
                            }
                        }

                        echo "🏁 Finished build for sample: ${dirName}"
                    }
                }
            }
        }
    }

    post {
        always {
            echo "🎉 All done—check above logs for any failures."
        }
    }
}
