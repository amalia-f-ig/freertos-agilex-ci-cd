pipeline {
    agent any

    environment {
        // WORKSPACE == /var/lib/jenkins/workspace/CI‑CD Pipelines
        SAMPLES_DIR = "${WORKSPACE}/Samples"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Samples Path') {
            steps {
                sh '''
                  echo "WORKSPACE = [$WORKSPACE]"
                  echo "Checking for Samples at   : [$SAMPLES_DIR]"
                  if [ ! -d "$SAMPLES_DIR" ]; then
                    echo "🔥 ERROR: Samples dir not found!"
                    ls -la "$WORKSPACE"
                    exit 1
                  fi
                  echo "✅ Found Samples dir."
                '''
            }
        }

        stage('List Sample Folders') {
            steps {
                script {
                    SAMPLE_DIRS = sh(
                        script:  "find \"$SAMPLES_DIR\" -mindepth 1 -maxdepth 1 -type d -printf \"%f\\n\"",
                        returnStdout: true
                    ).trim().split("\\n")
                    echo "🔍 Samples to build: ${SAMPLE_DIRS}"
                }
            }
        }

        stage('Build Each Sample (3× retry)') {
            steps {
                script {
                    for (sample in SAMPLE_DIRS) {
                        echo "⏳ Building sample: ${sample}"
                        boolean built = false
                        int attempt = 0

                        while (!built && attempt < 3) {
                            attempt++
                            echo "➡️  Attempt #${attempt} for ${sample}"
                            try {
                                dir("${SAMPLES_DIR}/${sample}") {
                                    if (fileExists('Jenkinsfile')) {
                                        echo "   ▶️  Loading Jenkinsfile in ${sample}"
                                        load 'Jenkinsfile'
                                    } else {
                                        echo "   ⚠️  No Jenkinsfile found—skipping ${sample}"
                                    }
                                }
                                built = true
                                echo "✅ ${sample} succeeded on attempt ${attempt}"
                            } catch (err) {
                                echo "❌ ${sample} failed on attempt ${attempt}: ${err}"
                                if (attempt == 3) {
                                    error("🚨 ${sample} failed after 3 attempts—aborting pipeline.")
                                } else {
                                    echo "🔄 Retrying ${sample}..."
                                }
                            }
                        }
                        echo "🏁 Done with ${sample}"
                    }
                }
            }
        }
    }

    post {
        always {
            echo "🎉 Pipeline complete. Check above logs for details."
        }
    }
}
