pipeline {
    agent any

    /* 
       We know from your last debug that the folder you really want lives at:
           /var/lib/jenkins/workspace/<your‑job‑name>/CI‑CD Pipelines/Samples
       and that ${WORKSPACE} is “/var/lib/jenkins/workspace/<your‑job‑name>”.
    */
    environment {
        ABS_SAMPLES_DIR = "${WORKSPACE}/CI-CD Pipelines/Samples"
    }

    stages {
        stage('Checkout') {
            steps {
                // make sure your repo is in the workspace
                checkout scm
            }
        }

        stage('Verify Samples Path') {
            steps {
                // quick verify that the folder exists before we try to find inside it
                sh '''
                  echo "Workspace = $WORKSPACE"
                  echo "Looking for Samples at: \"$ABS_SAMPLES_DIR\""
                  if [ ! -d "$ABS_SAMPLES_DIR" ]; then
                    echo "🔥 ERROR: Samples dir not found!"
                    ls -la "$WORKSPACE"
                    exit 1
                  fi
                  echo "✅ Found Samples directory."
                '''
            }
        }

        stage('List Samples') {
            steps {
                script {
                    // find all immediate subdirectories under the absolute path
                    SAMPLE_DIRS = sh(
                        script:  "find \"${ABS_SAMPLES_DIR}\" -mindepth 1 -maxdepth 1 -type d -printf \"%f\\n\"",
                        returnStdout: true
                    ).trim().split('\n')

                    echo "✅ Will build these samples: ${SAMPLE_DIRS}"
                }
            }
        }

        stage('Build Each Sample (with up to 3 retries)') {
            steps {
                script {
                    for (dirName in SAMPLE_DIRS) {
                        echo "⏳ Starting build for sample: ${dirName}"
                        def success = false
                        def attempt = 0

                        while (!success && attempt < 3) {
                            attempt++
                            echo "➡️  Attempt #${attempt} for ${dirName}"
                            try {
                                // use absolute path so we never get lost
                                dir("${ABS_SAMPLES_DIR}/${dirName}") {
                                    if (fileExists('Jenkinsfile')) {
                                        echo "   ▶️  Loading ${dirName}/Jenkinsfile"
                                        load 'Jenkinsfile'
                                    } else {
                                        echo "   ⚠️  No Jenkinsfile here; skipping build."
                                    }
                                }
                                success = true
                                echo "✅ Build succeeded for ${dirName} on attempt ${attempt}"
                            } catch (err) {
                                echo "❌ Build failed for ${dirName} on attempt ${attempt}: ${err}"
                                if (attempt == 3) {
                                    error("🚨 ${dirName} failed after 3 attempts — aborting.")
                                } else {
                                    echo "🔄 Retrying ${dirName}..."
                                }
                            }
                        }

                        echo "🏁 Finished build for sample: ${dirName}"
                    }
                }
            }
        }
    }

    post {
        always {
            echo "🚀 Pipeline complete. Check the logs above."
        }
    }
}
