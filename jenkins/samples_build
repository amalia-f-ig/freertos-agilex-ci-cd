pipeline {
    agent any

    environment {
        SAMPLES_DIR = 'Dashboard/CI-CD Pipelines/Samples'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Debug FS') {
          steps {
            sh '''
              echo "WORKSPACE = $PWD"
              ls -l .
              echo "--- see Dashboard subdir ---"
              ls -l Dashboard
            '''
          }
        }
        

        stage('List Samples') {
            steps {
                script {
                  SAMPLE_DIRS = sh(
                    script: 'find "Dashboard/CI-CD Pipelines/Samples" -mindepth 1 -maxdepth 1 -type d -printf "%f\\n"',
                    returnStdout: true
                  ).trim().split('\n')
                  echo "Found sample folders: ${SAMPLE_DIRS}"
                }

            }
        }

        stage('Build Each Sample') {
            steps {
                script {
                    for (dirName in SAMPLE_DIRS) {
                        def buildSuccess = false
                        def attempts = 0
                        echo "==> Starting build for sample: ${dirName}"

                        while (!buildSuccess && attempts < 3) {
                            attempts++
                            try {
                                dir("${SAMPLES_DIR}/${dirName}") {
                                    if (fileExists('Jenkinsfile')) {
                                        echo "Running Jenkinsfile inside ${dirName}, attempt ${attempts}"
                                        load 'Jenkinsfile'
                                        buildSuccess = true
                                    } else {
                                        echo "No Jenkinsfile found in ${dirName}, skipping..."
                                        buildSuccess = true  // Avoid retry if Jenkinsfile missing
                                    }
                                }
                            } catch (err) {
                                echo "Build attempt ${attempts} for ${dirName} failed: ${err}"
                                if (attempts >= 3) {
                                    error "Failed to build ${dirName} after 3 attempts."
                                } else {
                                    echo "Retrying ${dirName}..."
                                }
                            }
                        }

                        echo "<== Finished build for sample: ${dirName}"
                    }
                }
            }
        }
    }
}
