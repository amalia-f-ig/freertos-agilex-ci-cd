pipeline {
    agent any

    environment {
        QUARTUS_ROOTDIR = '/home/intel-ldra/altera_pro/25.1/quartus'
        ARM_GNU_TOOLCHAIN = '/home/intel-ldra/Zephyr_ATF_golden_ref_IGN/arm-gnu-toolchain-13.3.rel1-x86_64-aarch64-none-elf/bin'
        CMAKE_PATH= '/home/intel-ldra/Downloads/cmake-3.24.0-linux-x86_64/bin'
        PATH = "${ARM_GNU_TOOLCHAIN}:${CMAKE_PATH}:${QUARTUS_ROOTDIR}/bin:${QUARTUS_ROOTDIR}/linux64:${QUARTUS_ROOTDIR}/../qsys/bin:${env.PATH}"
        WORKSPACE_PATH = "/home/intel-ldra/Jenkins"
        REPO_PATH = "${WORKSPACE_PATH}/os.rtos.fpga.freertos"
        SCRIPT_REPO = "${WORKSPACE_PATH}/freertos-test-automation"
        SCRIPT_PATH = "${WORKSPACE_PATH}/freertos-test-automation/jenkins_scripts/PDK_scripts"
        AUTOMATION_SCRIPT= "${WORKSPACE_PATH}/freertos-test-automation/jenkins_scripts/driver_tests"
        PATCH = "${WORKSPACE_PATH}/patches/releasev5/tests/qspi_test.patch"
        BUILD_PATH = "${WORKSPACE_PATH}/os.rtos.fpga.freertos/drivers/tests"
        CLI_PATH = "${WORKSPACE_PATH}/freertos-test-automation/jenkins_scripts/driver_tests"
        BLOCK_NAME = "qspi"
    }

    stages {
        stage('Pre-clone Cleanup') {
            steps {
                script {
                    sh '''
                        if [ -d "${REPO_PATH}" ]; then
                            rm -rf "${REPO_PATH}"
                        fi
                        rm -f "${WORKSPACE}/test_results.txt"
                        rm -f "${WORKSPACE}/boot_log.txt"
                    '''
                }
            }
        }
        stage('Clone Repositories') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'af6609b7-75a7-43a2-9dfc-a6c45f0f4e44', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PASS')]) {
                        sh '''
                            git clone --branch feature/latest_altera_collaterals https://${GIT_USER}:${GIT_PASS}@github.com/intel-collab/os.rtos.fpga.freertos.git ${REPO_PATH}
                            cd ${REPO_PATH}
                            git -c submodule.fetchJobs=4 submodule update --init --recursive
                        '''
                    }
                }
            }
        }

        
        stage('Build Binaries') {
            steps {
                script {
                    sh '''
                        cd ${BUILD_PATH}
                        rm -rf build && cmake -B build -DSOF_PATH=/home/intel-ldra/Jenkins/os.rtos.fpga.freertos/tools/RC4/agilex5_devkit_soc_ghrd/ghrd_a5ed065bb32ae6sr0.sof -G Ninja && ninja -C build -j4 qspi-image
                    '''
                }
            }
        }

        stage('Check Python Version and Installed Packages') {
            steps {
                script {
                    sh '''
                        python3 --version
                        python3 -m pip list
                    '''
                }
            }
        }
        
        stage('Switch Device Mode') {
            steps {
                script {
                    sh '''
                        cd ${SCRIPT_PATH}
                        echo "==== Switch Device Mode ===="
                        python3 pdk_control.py 
                    '''
                }
            }
        }

        stage('Flash image') {
            steps {
                script {
                    sh '''
                        cd ${SCRIPT_PATH}
                        echo "==== Flashing JIC Image ====" 
                        cd ${BUILD_PATH}/build/qspi_atf_binaries
                        quartus_pgm -c 1 -m jtag -o "pvi;qspi_image.jic"
                    '''
                }
            }
        }

        stage('Power cycle device') {
            steps {
                script {
                    sh '''
                        cd ${SCRIPT_PATH}
                        echo "==== Power Cycle Device ===="
                        python3 power_cycle.py
                    '''
                }
            }
        }

    stage('Run python automation script') {
            steps {
                script {
                    sh '''
                        cd ${AUTOMATION_SCRIPT}
                        echo "==== PYTHON AUTOMATION SCRIPT ====" >> ${WORKSPACE}/test_results.txt
                        export PYTHONUSERBASE=$HOME/.local
                        python3 -m pip install --user pyserial 
                        python3 ${BLOCK_NAME}_test.py>> ${WORKSPACE}/test_results.txt 2>&1
                    '''
                }
            }
        }

        stage('Save Results') {
            steps {
                archiveArtifacts artifacts: 'boot_log.txt, test_results.txt', fingerprint: true
            }
        }
    }
    post {
    always {
        archiveArtifacts artifacts: 'boot_log.txt, test_results.txt', fingerprint: true
    }
}

}
