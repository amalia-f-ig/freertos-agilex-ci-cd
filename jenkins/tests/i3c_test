pipeline {
    agent any

    environment {
        SSH_USER = 'intel4'
        SSH_HOST = '192.168.40.24'
        REMOTE_PATH = '/home/intel4/Jenkins'
        REMOTE_SCRIPT_PATH = "${REMOTE_PATH}/freertos-test-automation/jenkins_scripts/PDK_scripts"
    }

    stages {

 stage('Remote: Cleanup') {
            steps {
                script {
                    sh """
                    ssh ${SSH_USER}@${SSH_HOST} 'rm -rf ${REMOTE_PATH}/os.rtos.fpga.freertos'
                    """
                }
            }
        }

        stage('Remote: Clone Repository') {
            steps {
                script {
                    sh """
                    ssh ${SSH_USER}@${SSH_HOST} << 'ENDSSH'
                    cd ${REMOTE_PATH}
                    git clone --branch release/v0.6.0 https://github.com/intel-collab/os.rtos.fpga.freertos.git
                    cd ${REMOTE_PATH}/os.rtos.fpga.freertos
                    git submodule update --init --recursive
                    ENDSSH
                    """
                }
            }
        }

        stage('Remote: Apply Patch') {
            steps {
                script {
                    sh """
                    ssh ${SSH_USER}@${SSH_HOST} << 'ENDSSH'
                    cd ${REMOTE_PATH}/os.rtos.fpga.freertos
                    git restore .
                    patch -p1 --force < ${PATCH_PATH}
                    ENDSSH
                    """
                }
            }
        }

        stage('Remote: Build') {
            steps {
                script {
                    sh """
                    ssh ${SSH_USER}@${SSH_HOST} << 'ENDSSH'
                    cd ${REMOTE_PATH}/os.rtos.fpga.freertos/drivers/tests
                    mkdir -p build && cd build
                    cmake ../
                    cd ${REMOTE_PATH}/os.rtos.fpga.freertos/drivers/tests/build
                    make clean
                    make
                    ENDSSH
                    """
                }
            }
        }

        stage('Remote: Switch Device Mode') {
            steps {
                script {
                    sh """
                    ssh ${SSH_USER}@${SSH_HOST} << 'ENDSSH'
                    cd ${REMOTE_SCRIPT_PATH}
                    python3 pdk_control.py
                    ENDSSH
                    """
                }
            }
        }

        stage('Remote: Generate JIC image') {
            steps {
                script {
                    sh """
                    ssh ${SSH_USER}@${SSH_HOST} << 'ENDSSH'
                    set -e
                    echo "=== Generating JIC image ==="
                    cd ${REMOTE_SCRIPT_PATH}
                    python3 generate_jic_image.py

                    echo "=== Flashing JIC image ==="
                    ./flash.sh
                    ENDSSH
                    """
                }
            }
        }


        stage('Remote: Power cycle device') {
            steps {
                script {
                    sh """
                    ssh ${SSH_USER}@${SSH_HOST} << 'ENDSSH'
                    cd ${REMOTE_SCRIPT_PATH}
                    python3 power_cycle.py
                    ENDSSH
                    """
                }
            }
        }

        stage('Remote: Run Python Automation Script') {
            steps {
                script {
                    sh """
                    ssh ${SSH_USER}@${SSH_HOST} << 'ENDSSH'
                    set -e
                    echo "==== Running Python Automation Script ===="
                    cd ${REMOTE_AUTOMATION_SCRIPT}
                    python3 -m pip install --user pyserial
                    python3 i3c_test.py >> ${REMOTE_WORKSPACE}/test_results.txt 2>&1
                    ENDSSH
                    """
                }
            }
        }

        stage('Pull Test Results from Remote') {
            steps {
                script {
                    sh """
                    scp ${SSH_USER}@${SSH_HOST}:${REMOTE_WORKSPACE}/test_results.txt ${WORKSPACE}/test_results.txt || true
                    scp ${SSH_USER}@${SSH_HOST}:${REMOTE_WORKSPACE}/boot_log.txt ${WORKSPACE}/boot_log.txt || true
                    """
                }
            }
        }



        stage('Save Results') {
            steps {
                archiveArtifacts artifacts: 'boot_log.txt, test_results.txt', fingerprint: true
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'boot_log.txt, test_results.txt', fingerprint: true
        }
    }
}
